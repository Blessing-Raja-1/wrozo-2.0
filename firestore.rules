rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // SEC-01: Helper used for checking incoming role values.
    // Only 'WORKER' and 'CONTRACTOR' are permitted. 'ADMIN' can NEVER be self-assigned.
    function isAllowedRole(role) {
      return role in ['WORKER', 'CONTRACTOR'];
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Capability authorization: checks user capabilities map with fallback to legacy role
    function hasWorkerCapability(uid) {
      let userData = getUserData(uid);
      return (userData.get('capabilities', {}).get('worker', false) == true)
        || (userData.get('role', '') == 'WORKER');
    }

    function hasContractorCapability(uid) {
      let userData = getUserData(uid);
      return (userData.get('capabilities', {}).get('contractor', false) == true)
        || (userData.get('role', '') == 'CONTRACTOR');
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // SEC-01 (create): role and capabilities are never part of the initial user document.
      // The account is created with minimal public fields; role/capability setup happens later.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['phone', 'status', 'createdAt']);

      // SEC-01 (update):
      // - capabilities CANNOT be written by client (must be assigned via trusted backend).
      // - activeMode may be updated by owner to 'WORKER' or 'CONTRACTOR' (presentation mode only).
      // - fcmTokens may be updated freely for push notification registration.
      // - legacy role may be written ONCE if currently absent (SEC-01 immutability).
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'fcmTokens', 'activeMode'])
        && (
          // Branch A: Non-role update (activeMode and/or fcmTokens)
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeMode'])
              || request.resource.data.activeMode in ['WORKER', 'CONTRACTOR']
            )
          )
          ||
          // Branch B: initial legacy role assignment (SEC-01: preserved for backwards compatibility and tests A5/A6)
          (
            (!('role' in resource.data) || resource.data.role == null)
            && isAllowedRole(request.resource.data.role)
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeMode'])
              || request.resource.data.activeMode in ['WORKER', 'CONTRACTOR']
            )
          )
        );

      match /device_tokens/{tokenId} {
        // SEC-FCM: Only the authenticated owner can read, write, or delete their device tokens.
        // Cross-user token modification, spoofing, and reading are strictly blocked.
        allow read, write: if isOwner(userId);
      }
    }

    match /worker_profiles/{userId} {
      // SEC-PRIVACY: Authenticated users can retrieve a single worker's public profile by ID (for applicant reviews/hiring)
      allow get: if isAuthenticated();
      // SEC-ANTI-SCRAPING: Prevent data scraping and bulk enumeration of worker profiles
      allow list: if false;

      // SEC-03: Enforce that all server-controlled metric fields are at their zero values on creation.
      // A client cannot forge rating, reviewCount, or jobsCompleted.
      allow create: if isOwner(userId)
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.jobsCompleted == 0;

      // Prevent client updates to server-controlled fields (unchanged)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'reviewCount', 'jobsCompleted']);

      // Client profile deletion is permanently blocked
      allow delete: if false;

      // Owner-only private subcollection (sensitive contact, KYC, bank details)
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /contractor_profiles/{userId} {
      // SEC-PRIVACY: Authenticated users can retrieve a single contractor's public profile by ID (for job postings)
      allow get: if isAuthenticated();
      // SEC-ANTI-SCRAPING: Prevent data scraping and bulk enumeration of contractor profiles
      allow list: if false;

      // SEC-03: Enforce that all server-controlled metric fields are at their zero/false values on creation.
      // A client cannot forge rating, reviewCount, or isVerified status.
      allow create: if isOwner(userId)
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.isVerified == false;

      // Prevent client updates to server-controlled fields (unchanged)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'reviewCount', 'isVerified']);

      // Client profile deletion is permanently blocked
      allow delete: if false;

      // Owner-only private subcollection (sensitive contact, tax/GST, bank details)
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /jobs/{jobId} {
      allow read: if isAuthenticated() && (resource.data.status == 'OPEN' || resource.data.contractorId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.contractorId == request.auth.uid
        && hasContractorCapability(request.auth.uid)
        && request.resource.data.status == 'OPEN';
      allow update: if isAuthenticated()
        && resource.data.contractorId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['contractorId', 'createdAt']);
    }

    match /applications/{appId} {
      allow read: if isAuthenticated() && (resource.data.workerId == request.auth.uid || resource.data.contractorId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && appId == request.resource.data.jobId + '_' + request.resource.data.workerId
        && hasWorkerCapability(request.auth.uid);
      allow update: if isAuthenticated()
        && (
             (resource.data.contractorId == request.auth.uid && request.resource.data.status in ['ACCEPTED', 'REJECTED']) ||
             (resource.data.workerId == request.auth.uid && request.resource.data.status == 'WITHDRAWN')
           )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['workerId', 'contractorId', 'jobId', 'createdAt']);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function isCanonicalConversationId(cId, p0, p1) {
        return cId == (p0 < p1 ? p0 + '_' + p1 : p1 + '_' + p0);
      }

      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Conversations can only be created between two distinct users who have an ACCEPTED application.
      allow create: if isAuthenticated()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && isCanonicalConversationId(
             conversationId,
             request.resource.data.participants[0],
             request.resource.data.participants[1]
           )
        && request.resource.data.applicationId is string
        && exists(/databases/$(database)/documents/applications/$(request.resource.data.applicationId))
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.status == 'ACCEPTED'
        && request.auth.uid in [
             get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.workerId,
             get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.contractorId
           ]
        && request.resource.data.participants.hasAll([
             get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.workerId,
             get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.contractorId
           ]);

      // Participants, applicationId, and createdAt cannot be changed by clients.
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'applicationId', 'createdAt']);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update: if false; // Messages are immutable
        allow delete: if false; // Client deletion of messages is denied
      }
    }

    match /payments/{paymentId} {
      // SEC-02: Only the payment participants (worker and contractor) may read their own payment records.
      allow read: if isAuthenticated()
        && (resource.data.workerId == request.auth.uid || resource.data.contractorId == request.auth.uid);

      // SEC-02: NO client write is ever permitted on payment documents.
      // Payment records must only be created or modified by a trusted server-side process
      // (e.g., a Cloud Function receiving and cryptographically verifying a payment gateway webhook).
      // This prevents clients from fabricating PENDING, COMPLETED, FAILED, or REFUNDED states.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.revieweeId != request.auth.uid
        && reviewId == request.resource.data.jobId + '_' + request.resource.data.reviewerId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if false; // Reviews are immutable
      allow delete: if false; // Reviews cannot be deleted by clients
    }

    // Deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
